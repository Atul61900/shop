# ---------------------------------------------------------------------------
# Copy to `.env` and fill in. `.env` is git-ignored — never commit real keys.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, sitemap, payment return URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Database
# Local dev uses SQLite (zero setup).
# For production, switch `provider` in prisma/schema.prisma to "postgresql"
# and point this at your instance — no schema changes needed.
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# ---------------------------------------------------------------------------
# Currency — amounts are stored as integer minor units (paisa)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_CURRENCY=NPR
NEXT_PUBLIC_LOCALE=en-NP

# ---------------------------------------------------------------------------
# Sessions
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
AUTH_SECRET="dev-only-insecure-secret-change-me"

# ---------------------------------------------------------------------------
# eSewa  (leave blank to hide the option at checkout)
# Sign up at https://developer.esewa.com.np
# ---------------------------------------------------------------------------
ESEWA_ENV=sandbox
ESEWA_MERCHANT_ID=
ESEWA_SECRET_KEY=
ESEWA_PROFILE_ID=

# ---------------------------------------------------------------------------
# Khalti  (leave blank to hide the option at checkout)
# Sign up at https://developer.khalti.com
# ---------------------------------------------------------------------------
KHALTI_ENV=sandbox
KHALTI_SECRET_KEY=

# ---------------------------------------------------------------------------
# Outbound email for password resets / order receipts
# Leave SMTP_HOST blank in development — reset links are logged to the console
# instead of sent, so you can still test the full flow.
# ---------------------------------------------------------------------------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="KMRC <no-reply@kmrc.com.np>"
# ---------------------------------------------------------------------------
# Staff account (admin@kmrc.com.np)
#
# Used by `npx prisma db seed` to create the staff login, and by the smoke
# suite to sign in as staff. Leave it blank locally and the seed will generate
# a strong password and print it once. Set it in production to a value only
# you know, then rotate with: npx tsx prisma/set-admin.ts --password
# ---------------------------------------------------------------------------
ADMIN_PASSWORD=
